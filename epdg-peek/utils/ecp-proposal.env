# Provide a fixed IP address for the ePDG to connect to
#EPDG_IP=192.168.1.100

# Control the IKE proposal
# Include insecure DH groups
#INSECURE_DH=1
# Provide a custom IKE proposal: https://docs.strongswan.org/docs/latest/config/proposals.html
CUSTOM_IKE_PROPOSAL="aes128-aes256-prfsha256-prfsha384-sha1-sha256-ecp224-ecp256"

# Control the ESP proposal
# Reverse ordering, to prefer the weakest cipher
#ESP_WEAKEST_FIRST=1
# Include the NULL cipher
#ESP_INSECURE=1
# Provide a custom ESP proposal: https://docs.strongswan.org/docs/latest/config/proposals.html
CUSTOM_ESP_PROPOSAL="aes256-aes128-sha512-sha256-sha1-aesxcbc-ecp224-ecp256-noesn"

# Skip starting the packet capture
#SKIP_PACKET_CAPTURE=1

# Skip the default scripts (ping P-CSCF, check internet connectivity)
#SKIP_DEFAULT_SCRIPTS=1

# Write stats CSV file without header for stream-processing
#SKIP_STATS_FILE_HEADER=1

# User IPv4 in IPsec tunnel
#EPDG_TUN_IPV4=1

# Domain to create canary subdomains for
#DNS_CANARY_DOMAIN=G42.your-id-here.canarytokens.com

# Run full F11 ESP proposal testing
#TESTCASE_F11_FULL=1
